{
  "name": "tattlejay",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && node server/main.ts",
    "serve": "node server/main.ts",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware server web/src",
